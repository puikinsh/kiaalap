{
  "name": "kiaalap",
  "version": "4.0.0",
  "description": "Modern Bootstrap 5 Education Management Dashboard - Free admin dashboard template",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "vite",
    "test": "node --test tests/unit.test.js tests/styles.test.js",
    "clean": "node scripts/clean.js",
    "lint:html": "html-validate \"*.html\"",
    "lint:css": "node scripts/lint-styles.js",
    "lint:js": "eslint src scripts tests vite.config.js eslint.config.js playwright.config.js",
    "format": "prettier --write \"src/**/*.{js,scss,css,hbs}\" \"*.html\" \"scripts/*.js\" \"tests/*.js\" \"*config*.{js,cjs}\"",
    "test:build": "node --test tests/build.test.js",
    "test:browser": "playwright test",
    "check": "npm run lint:js && npm run lint:css && npm test && npm run build && npm run lint:html:built && npm run test:build",
    "lint:html:built": "html-validate \"dist/*.html\"",
    "page:new": "node scripts/create-page.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puikinsh/kiaalap.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/puikinsh/kiaalap/issues"
  },
  "homepage": "https://github.com/puikinsh/kiaalap#readme",
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "aos": "^2.3.4",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "chart.js": "^4.5.1",
    "countup.js": "^2.10.1",
    "cropperjs": "^2.3.0",
    "dayjs": "^1.11.23",
    "fullcalendar": "^7.1.2",
    "leaflet": "^1.9.4",
    "prismjs": "^1.30.0",
    "quill": "2.0.2",
    "simple-datatables": "^10.3.0",
    "simplebar": "^6.3.3",
    "swiper": "^14.3.0",
    "tom-select": "^2.6.2"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "html-validate": "^11.16.2",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "sass": "^1.105.1",
    "vite": "^8.3.4",
    "vite-plugin-handlebars": "^2.0.3"
  },
  "engines": {
    "node": "^22.22.0 || >=24.8.0",
    "npm": ">=10"
  }
}
